# Web app settings (copy to web/.env.local). Public values only: never put a private key here,
# every VITE_* variable is bundled into the browser build.

# Which exported contract config to use from web/src/contracts/: localhost | amoy
VITE_NETWORK=localhost

# Optional: override the read-only RPC used by the public verify page and role detection.
# Defaults: localhost -> http://127.0.0.1:8545, amoy -> https://rpc-amoy.polygon.technology
VITE_RPC_URL=
